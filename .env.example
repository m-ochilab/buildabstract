# Copy this file to .env and fill in the values you want to use locally.

# OpenRouter settings
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-pro
OPENROUTER_MAX_CONCURRENCY=10

# Optional Ollama fallback settings
OLLAMA_URLS=http://127.0.0.1:11434,http://127.0.0.1:11435,http://127.0.0.1:11436
OLLAMA_MODEL=glm-4.7-flash:latest

# Shared settings
OLLAMA_TIMEOUT_SECONDS=120
GUIDANCE_PATH=./guidance.txt
SYNOLOGY_CHAT_WEBHOOK_URL=
